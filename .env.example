# Local development: use the Vite proxy to reach the backend.
VITE_API_BASE_URL=/api/v1
# Set this in .env.local to the backend laptop's LAN origin, e.g. http://<backend-host>:8000.
VITE_API_PROXY_TARGET=
# Set true only if production hosting has a working server-side /api proxy.
#VITE_API_SERVER_PROXY=true
# Production builds use .env.production. Firebase Hosting serves HTTPS, so an
# HTTP backend requires HTTPS on the backend or a working HTTPS server-side proxy.
#VITE_GOOGLE_MAPS_API_KEY=
